# QuantMind OSS Edition - Single Image
# 构建一个镜像运行所有后端服务

FROM python:3.10-slim-bookworm

# 镜像源参数（构建时可传入）
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ARG PIP_TRUSTED_HOST=mirrors.aliyun.com
ARG APT_MIRROR=mirrors.aliyun.com

# torch 版本选择：cpu（默认，构建快、镜像小）、gpu（含 CUDA，需 GPU 且构建慢、镜像 ~24GB）
# 或 skip（跳过 torch 安装，无 CUDA/PyTorch，适合纯行情/交易服务）
# 用法: docker build --build-arg TORCH_DEVICE=gpu ...
ARG TORCH_DEVICE=cpu
# CPU 版 torch 的国内下载源（阿里云 pytorch-wheels，含 +cpu 轮子）
ARG TORCH_CPU_INDEX_URL=https://mirrors.aliyun.com/pytorch-wheels/cpu

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_TRUSTED_HOST=${PIP_TRUSTED_HOST} \
    PYTHONPATH=/app \
    SERVICE_MODE=all

WORKDIR /app

# 配置 APT 镜像源
RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
      sed -i "s/deb.debian.org/${APT_MIRROR}/g" /etc/apt/sources.list.d/debian.sources; \
      sed -i "s/security.debian.org/${APT_MIRROR}/g" /etc/apt/sources.list.d/debian.sources; \
    else \
      sed -i "s/deb.debian.org/${APT_MIRROR}/g" /etc/apt/sources.list; \
      sed -i "s/security.debian.org/${APT_MIRROR}/g" /etc/apt/sources.list; \
    fi

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      cmake \
      curl \
      git \
      libgomp1 \
      swig \
      openssh-client \
      rsync \
      sshpass \
      fonts-wqy-zenhei \
    && rm -rf /var/lib/apt/lists/*

# 安装 Python 依赖
COPY requirements.txt /tmp/requirements.txt
COPY requirements/production.txt /tmp/requirements-production.txt
COPY requirements/ai.txt /tmp/requirements-ai.txt

# 本地 torch wheel 目录（docker/torch_wheels/）被 .gitignore 忽略、不随代码分发。
# 默认按 TORCH_DEVICE 从 PyPI 安装 torch：
#   cpu -> torch==2.9.1+cpu（仅 CPU 轮子，构建快、镜像小，无需 GPU）
#   gpu -> torch==2.9.1（完整 CUDA 轮子，构建慢、镜像大，需 NVIDIA GPU）
# 需要离线/定制 wheel 时自行 COPY docker/torch_wheels/ 后放开下方本地分支。
RUN python -m pip install --upgrade pip setuptools wheel cython \
    && if [ "$TORCH_DEVICE" = "skip" ] || [ "$TORCH_DEVICE" = "none" ]; then \
         echo "跳过 torch 安装（TORCH_DEVICE=${TORCH_DEVICE}，不包含 CUDA/PyTorch）"; \
       elif ls /tmp/torch_wheels/*.whl >/dev/null 2>&1; then \
         echo "安装本地 torch wheel"; \
         python -m pip install --no-cache-dir --root-user-action=ignore /tmp/torch_wheels/*.whl; \
       elif [ "$TORCH_DEVICE" = "gpu" ]; then \
         echo "构建 GPU 版 torch（完整 CUDA，构建慢）"; \
         python -m pip install --no-cache-dir --root-user-action=ignore "torch==2.9.1"; \
       else \
         echo "构建 CPU 版 torch（快速、无需 GPU）"; \
         python -m pip install --no-cache-dir --root-user-action=ignore "torch==2.9.1+cpu" \
           --index-url ${TORCH_CPU_INDEX_URL}; \
       fi \
    && python -m pip install --no-cache-dir --root-user-action=ignore -r /tmp/requirements.txt \
    && python -m pip install --no-cache-dir --root-user-action=ignore -r /tmp/requirements-production.txt \
    && python -m pip install --no-cache-dir --root-user-action=ignore -r /tmp/requirements-ai.txt \
    && rm -rf /tmp/requirements*.txt /tmp/torch_wheels

# 安装 QuantDB SDK（付费高质量数据源：K线/Tick/财报/估值/315维AI因子）
RUN python -m pip install --no-cache-dir --root-user-action=ignore "quantdb-sdk>=0.3.1"

# 修复 qlib 0.9.7 bug: position.py 中 price=None 导致 TypeError
COPY docker/patch_qlib.py /tmp/patch_qlib.py
RUN python /tmp/patch_qlib.py && rm /tmp/patch_qlib.py

# 安装 rd-agent 因子演化模块（可选，目录不存在则跳过）
# rd-agent 在 .gitignore 中，OSS 克隆后可能不存在
COPY docker/install_rdagent.sh /tmp/install_rdagent.sh
# rd-agent 源码（OSS 克隆可能不存在；install 脚本会自行跳过）
COPY rd-agent/ /app/rd-agent/
RUN chmod +x /tmp/install_rdagent.sh && /tmp/install_rdagent.sh && rm /tmp/install_rdagent.sh

# 预下载 FinBERT 中文金融情绪模型权重（~100MB，news.sentiment 惰性加载用；
# 构建时下载到 /root/.cache/huggingface，运行时离线可用，不依赖 HF 网络）
RUN HF_HUB_OFFLINE=0 python - <<'PY'
import os, sys
try:
    from huggingface_hub import snapshot_download
    snapshot_download(
        repo_id="bardsai/finance-sentiment-zh-base",
        local_dir_use_symlinks=False,
    )
    print("FinBERT 权重下载完成")
except Exception as e:
    print(f"FinBERT 下载跳过（构建环境无网络时不影响镜像构建）: {e}")
PY

# 复制训练脚本（确保容器内 /app/train.py 存在，避免卷挂载失败时 Docker 创建目录）
COPY docker/training/train.py /app/train.py

# 复制源代码
COPY backend backend
COPY config config
COPY scripts scripts
COPY strategy_templates strategy_templates

# 创建数据目录 & Qlib 符号链接（运行时由 rd_loop_wrapper 按实际缓存路径创建）
RUN mkdir -p /data/models /data/qlib_data /data/uploads /data/strategies \
    /data/sector-memberships /tmp \
    && mkdir -p /root/.qlib/qlib_data
# Qlib features 符号链接在运行时由 entrypoint 或首次访问时创建（数据卷挂载后才存在）

# 暴露端口
EXPOSE 8000 8001 8002 8003

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 启动所有服务
CMD ["python", "backend/main_oss.py"]
